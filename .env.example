# ApprovalFlow environment — copy to .env and adjust. Never commit .env.

# ---- LLM provider (M15: swappable by config; the chat client is the only provider-specific line)
# One of: ollama | groq | gemini | stub
# `stub` is a deterministic local model used by CI and tools/verify.py — no network, no rate limits.
LLM_PROVIDER=ollama

# Model name as known by the provider.
LLM_MODEL=qwen2.5:3b

# OpenAI-compatible endpoint base URL.
#   Ollama in compose (default):  http://ollama:11434/v1
#   Ollama on the host machine:   http://host.docker.internal:11434/v1
#   Groq:                         https://api.groq.com/openai/v1
#   Gemini:                       https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=http://ollama:11434/v1

# API key. Ollama ignores it (any non-empty value); Groq/Gemini need a real key.
LLM_API_KEY=ollama

# Model the ollama container pulls on first start.
OLLAMA_MODEL=qwen2.5:3b

# ---- RabbitMQ (Dapr pub/sub broker)
RABBITMQ_USER=approvalflow
RABBITMQ_PASSWORD=approvalflow-dev

# ---- Controller token required to change autonomy thresholds at runtime
# (PUT /config/thresholds with header X-Config-Token). Change for any real use.
CONFIG_API_TOKEN=approvalflow-dev-config-token
